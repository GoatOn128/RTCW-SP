{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (x64 release)",
            "type": "shell",
            "command": "scons",
            "args": [
                "arch=x64",
                "config=release",
                "-j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build (x64 debug)",
            "type": "shell",
            "command": "scons",
            "args": [
                "arch=x64",
                "config=debug",
                "-j8"
            ],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build (x86 release)",
            "type": "shell",
            "command": "scons",
            "args": [
                "arch=x86",
                "config=release",
                "-j8"
            ],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build (x64 release, renderer hard-linked)",
            "type": "shell",
            "command": "scons",
            "args": [
                "arch=x64",
                "config=release",
                "hardlink=renderer",
                "-j8"
            ],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "scons",
            "args": [
                "-c"
            ],
            "problemMatcher": []
        }
    ]
}
