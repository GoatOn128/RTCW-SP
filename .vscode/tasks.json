{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (x86)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "visual-studio"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Configure (x64)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "visual-studio-x64"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (x86 release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-release"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (x86 debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-debug"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (x64 release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-x64-release"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (x64 debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-x64-debug"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (Linux x64 release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-release"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (Linux x64 debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-debug"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (Linux x86 release)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-x86-release"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Build (Linux x86 debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-x86-debug"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Clean (x86)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-release", "--target", "clean"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        },
        {
            "label": "Clean (x64)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "visual-studio-x64-release", "--target", "clean"],
            "options": { "cwd": "${workspaceFolder}/src" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": false, "showReuseMessage": false }
        }
    ]
}
