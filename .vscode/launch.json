{
    // Debugging needs the game data next to bin/ (WolfSP.exe, renderer dlls
    // and bin/main/ modules are all inside bin/).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WolfSP (Windows, x64 debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x64.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x64 debug)",
            "console": "integratedTerminal"
        },
        {
            "name": "WolfSP (Windows, x64 release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x64.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x64 release)",
            "console": "integratedTerminal"
        },
        {
            "name": "WolfSP (Windows, x86 debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x86.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x86 debug)",
            "console": "integratedTerminal"
        },
        {
            "name": "WolfSP (Windows, x86 release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x86.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x86 release)",
            "console": "integratedTerminal"
        },
        {
            "name": "WolfSP (Linux, x64 debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x64",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x64 debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "WolfSP (Linux, x64 release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x64",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x64 release)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "WolfSP (Linux, x86 debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x86",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x86 debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "WolfSP (Linux, x86 release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x86",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x86 release)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
