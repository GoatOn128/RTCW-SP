// Wolf CG_LoseHat controller. Values preserve the original appearance.
controller
{
 name body
 parameters
 {
  // velocity[0] = dir[0] * ( 0.75 + random() ) * GIB_VELOCITY;
  velocity_x "0.75"
  // velocity[1] = dir[1] * ( 0.75 + random() ) * GIB_VELOCITY;
  velocity_y "0.75"
  // velocity[2] = GIB_JUMP - 50 + dir[2] * ( 0.5 + random() ) * GIB_VELOCITY;
  velocity_z "50"
  // velocity[2] = GIB_JUMP - 50 + dir[2] * ( 0.5 + random() ) * GIB_VELOCITY;
  velocity_z_2 "0.5"
  // le->endTime = le->startTime + 20000 + ( crandom() * 5000 );
  le_endTime "20000"
  // le->endTime = le->startTime + 20000 + ( crandom() * 5000 );
  le_endTime_2 "5000"
  // le->angles.trDelta[0]   = 0;
  le_angles_trDelta_x "0"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y "100"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y_2 "500"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y_3 "300"
  // le->angles.trDelta[2]   = 400;  // (SA) this is set with a very particular value to try to get it
  le_angles_trDelta_z "400"
  // le->bounceFactor = 0.2;
  le_bounceFactor "0.2"
  // le->onFireEnd = cent->currentState.onFireEnd + 4000;
  le_onFireEnd "4000"
  // re->fadeStartTime       = le->endTime - 1000;
  re__fadeStartTime_value "1000"
 }
}
