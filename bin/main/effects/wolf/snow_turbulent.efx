// Wolf: snow_turbulent. Appearance is configured here.
particle
{
 name body
 count 1
 life 86400000
 shader snow_tri
 flags useAlpha setShaderTime
 spawnFlags cheapOrgCalc absoluteVel absoluteAccel
 rotation 0
 velocity -16 -16 -65 16 16 -65
 acceleration 0 0 0
 bindings "shader volume"
 size
 {
  start 1
  end 1
  flags linear
 }
 alpha
 {
  start 0.4
  end 0
  parm 100
  flags nonlinear
 }
 rgb
 {
  start 1 1 1
  end 1 1 1
 }
 repeat 1
}
