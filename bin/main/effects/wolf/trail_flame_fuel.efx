// Wolf connected ribbon: trail_flame_fuel.
ribbon
{
 name body
 life 1
 shader flamethrowerFireStream
 bindings "alpha alphaEnd width mapping color colorEnd"
 size
 {
  start 1
  end 200
 }
 alpha
 {
  start 1
  end 1
 }
 rgb
 {
  start 1 1 1
  end 1 1 1
 }
 parameters
 {
  flags 14
  mapping 1
  ratio 0.5
  speed 1.5
  alphaScale 1
  sparkColor 0
  sparkGreen .2
  sparkBlue .4
 }
}
