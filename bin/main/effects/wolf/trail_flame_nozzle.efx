// Wolf connected ribbon: trail_flame_nozzle.
ribbon
{
 name body
 life 1
 shader white
 bindings "alpha alphaEnd width color colorEnd shader"
 size
 {
  start 1
  end 200
 }
 alpha
 {
  start 1
  end 1
 }
 rgb
 {
  start 1 1 1
  end 1 1 1
 }
 parameters
 {
  flags 12
  mapping 0
  ratio 1.0
  speed 5.0
  alphaScale 1
  sparkColor 0
  sparkGreen .2
  sparkBlue .4
 }
}
