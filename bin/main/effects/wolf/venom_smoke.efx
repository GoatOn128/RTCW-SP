// Wolf venom_smoke: authored particle appearance.
particle
{
 name body
 count 1
 life 1200
 shader shotgunSmokePuff
 flags useAlpha setShaderTime
 spawnFlags cheapOrgCalc absoluteVel absoluteAccel
 bindings velocity
 rotation 0 360
 fadeIn 0
 size
