// Wolf CG_MachineGunEjectBrassNew controller. Values preserve the original appearance.
controller
{
 name body
 parameters
 {
  // velocity[0] = 16;
  velocity_x "16"
  // velocity[1] = -50 + 40 * crandom();
  velocity_y "50"
  // velocity[1] = -50 + 40 * crandom();
  velocity_y_2 "40"
  // velocity[2] = 100 + 50 * crandom();
  velocity_z "100"
  // velocity[2] = 100 + 50 * crandom();
  velocity_z_2 "50"
  // le->endTime = le->startTime + cg_brassTime.integer + ( cg_brassTime.integer / 4 ) * random();
  le_endTime "4"
  // le->pos.trTime = cg.time - ( rand() & 15 );
  le_pos_trTime "15"
  // le->bounceFactor = 0.4 * waterScale;
  le_bounceFactor "0.4"
  // le->angles.trBase[0] = rand() & 31;
  le_angles_trBase_x "31"
  // le->angles.trBase[1] = rand() & 31;
  le_angles_trBase_y "31"
  // le->angles.trBase[2] = rand() & 31;
  le_angles_trBase_z "31"
  // le->angles.trDelta[0] = 2;
  le_angles_trDelta_x "2"
  // le->angles.trDelta[1] = 1;
  le_angles_trDelta_y "1"
  // le->angles.trDelta[2] = 0;
  le_angles_trDelta_z "0"
  // end[2] -= 24;
  end_z "24"
  // fixed model resource
  smallgunBrassModel "models/weapons2/shells/sm_shell.md3"
 }
}
