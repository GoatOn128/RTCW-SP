// Wolf CG_LoseArmor controller. Values preserve the original appearance.
controller
{
 name body
 parameters
 {
  // int totalparts = 0, dynamicparts = 0, protoParts = 9, superParts = 16, heinrichParts = 22;
  totalparts "9"
  // int totalparts = 0, dynamicparts = 0, protoParts = 9, superParts = 16, heinrichParts = 22;
  totalparts_2 "16"
  // int totalparts = 0, dynamicparts = 0, protoParts = 9, superParts = 16, heinrichParts = 22;
  totalparts_3 "22"
  // int dmgbits = 16;         // 32/2;
  dmgbits "16"
  // dynamicparts = 14;  // the other two stay permanent
  dynamicparts "14"
  // dynamicparts = 20;  // will get kicked down to 16
  dynamicparts_2 "20"
  // velocity[2] = FLY_JUMP - 50 + dir[2] * ( 0.5 + random() ) * FLY_VELOCITY;
  velocity_z "50"
  // velocity[2] = FLY_JUMP - 50 + dir[2] * ( 0.5 + random() ) * FLY_VELOCITY;
  velocity_z_2 "0.5"
  // le->endTime = le->startTime + 20000 + ( crandom() * 5000 );
  le_endTime "20000"
  // le->endTime = le->startTime + 20000 + ( crandom() * 5000 );
  le_endTime_2 "5000"
  // le->angles.trDelta[0]   = 0;
  le_angles_trDelta_x "0"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y "100"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y_2 "500"
  // le->angles.trDelta[1]   = ( 100 + ( rand() & 500 ) ) - 300;
  le_angles_trDelta_y_3 "300"
  // le->angles.trDelta[2]   = 400;
  le_angles_trDelta_z "400"
  // le->bounceFactor = 0.4;
  le_bounceFactor "0.4"
  // FxTrailInputs().Time( le->lastTrailTime + 50 ) );
  tuning "50"
  // le->onFireEnd = cent->currentState.onFireEnd + 4000;
  le_onFireEnd "4000"
  // re->fadeStartTime       = le->endTime - 1000;
  re__fadeStartTime_value "1000"
 }
}
