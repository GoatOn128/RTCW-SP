// Wolf: snow_flurry. Appearance is configured here.
particle
{
 name body
 count 1
 life 1000
 shader snow_tri
 flags useAlpha setShaderTime
 spawnFlags cheapOrgCalc absoluteVel absoluteAccel
 rotation 0
 velocity -16 -16 -10 16 16 -10
 acceleration -32 -32 0 32 32 0
 velocityScale 32 32 1
 bindings "shader life fadeTime velocity"
 size
 {
  start 1
  end 1
  flags linear
 }
 alpha
 {
  start 0.9
  end 0
  parm 0
  flags nonlinear
 }
 rgb
 {
  start 1 1 1
  end 1 1 1
 }
 
}
