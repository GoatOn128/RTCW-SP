// Wolf connected ribbon: trail_debris_smoke.
ribbon
{
 name body
 life 1
 shader smokeTrail
 bindings "life alpha widthEnd"
 size
 {
  start 1
  end 1
 }
 alpha
 {
  start 1
  end 0
 }
 rgb
 {
  start 0 0 0
  end 0 0 0
 }
 parameters
 {
  flags 1
  mapping 1
  ratio 4
  speed 0
  alphaScale 1
  sparkColor 0
  sparkGreen .2
  sparkBlue .4
 }
}
